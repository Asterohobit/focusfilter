{
  "manifest_version": 3,
  "name": "FocusFilter",
  "version": "1.1.0",
  "description": "Blocks YouTube Shorts and annoying elements.",
  "homepage_url": "https://github.com/Asterohobit/focusfilter",

  "icons": {
  "16": "icons/focusfilter-16.png",
  "32": "icons/focusfilter-32.png",
  "48": "icons/focusfilter-48.png",
  "64": "icons/focusfilter-64.png",
  "128": "icons/focusfilter-128.png",
  "256": "icons/focusfilter-256.png"
  },

  "action": {
  "default_popup": "popup.html",
  "default_title": "FocusFilter",
  "default_icon": {
    "16": "icons/focusfilter-16.png",
    "32": "icons/focusfilter-32.png",
    "48": "icons/focusfilter-48.png",
    "64": "icons/focusfilter-64.png",
    "128": "icons/focusfilter-128.png",
    "256": "icons/focusfilter-256.png"
  }
  },

  "permissions": ["storage", "activeTab"],
  "content_scripts": [
  {
    "matches": ["*://*.youtube.com/*"],
    "js": ["content.js"],
    "run_at": "document_start"
  } 
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "@focusfilter",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
